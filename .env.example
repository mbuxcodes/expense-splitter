# Expense Splitter -- Docker Compose environment variables (repo root).
# Copy this file to .env and fill in real values. Never commit .env (it's git-ignored).
#
# This file is distinct from client/.env.example and server/.env.example:
# those configure the application itself; this one configures the MongoDB
# container that docker-compose.yml starts.

MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=expense_splitter
