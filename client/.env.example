# Expense Splitter -- client environment variables.
# Copy this file to .env and fill in real values. Never commit .env (it's git-ignored).

# Base URL the frontend uses to reach the backend API, including the version
# prefix (API_SPECIFICATION.md Section 2) -- every request path in
# services/apiEndpoints.ts is relative to this, e.g. VITE_API_BASE_URL +
# API_ENDPOINTS.health.basic = http://localhost:5000/api/v1/health.
VITE_API_BASE_URL=http://localhost:5000/api/v1
