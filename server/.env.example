# Expense Splitter -- server environment variables.
# Copy this file to .env and fill in real values. Never commit .env (it's git-ignored).

# Runtime mode. "development" for local work (verbose logging, per BACKEND_ARCHITECTURE.md Section 18).
NODE_ENV=development

# Port the Express server listens on. Matches docker-compose.yml's server port mapping.
PORT=5000

# MongoDB connection string. In Docker, "mongodb" is the service name from
# docker-compose.yml (Docker's internal DNS resolves it) -- not "localhost".
# Must match the root .env file's MONGO_ROOT_USERNAME / MONGO_ROOT_PASSWORD / MONGO_DATABASE.
MONGODB_URI=mongodb://<MONGO_ROOT_USERNAME>:<MONGO_ROOT_PASSWORD>@mongodb:27017/expense_splitter?authSource=admin

# Signing secret for JWT access tokens (SECURITY_ARCHITECTURE.md Section 2).
# Generate a long, random value for local dev -- never reuse a production secret here.
JWT_SECRET=<your-jwt-secret>

# Allowed frontend origin for CORS (SECURITY_ARCHITECTURE.md Section 6).
# Matches the client's local dev server.
CORS_ORIGIN=http://localhost:5173

# --- Future V2 -- not consumed by any code path yet (API_SPECIFICATION.md Section 22) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Required once the password-reset email flow is implemented (BACKEND_ARCHITECTURE.md Section 5) ---
# EMAIL_SERVICE_API_KEY=
